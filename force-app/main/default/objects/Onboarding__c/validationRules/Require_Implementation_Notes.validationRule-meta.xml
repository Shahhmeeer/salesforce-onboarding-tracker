<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Implementation_Notes</fullName>
    <active>true</active>
    <description
  >Requires Implementation Notes before an onboarding moves to any stage after Implementation.</description>
    <errorConditionFormula
  >NOT($Setup.Automation_Bypass__c.Bypass_Validation_Rules__c) &amp;&amp;
ISCHANGED(Stage__c) &amp;&amp;
CASE(TEXT(Stage__c),
    "Kickoff_Scheduled", 1,
    "Gathering_Info", 2,
    "Implementation", 3,
    "QA_Review", 4,
    "Go_Live", 5,
    "Post_Launch_Review", 6,
    0
) &gt; 3 &amp;&amp;
ISBLANK(Implementation_Notes__c)</errorConditionFormula>
    <errorDisplayField>Implementation_Notes__c</errorDisplayField>
    <errorMessage
  >Add Implementation Notes before moving past Implementation.</errorMessage>
</ValidationRule>
