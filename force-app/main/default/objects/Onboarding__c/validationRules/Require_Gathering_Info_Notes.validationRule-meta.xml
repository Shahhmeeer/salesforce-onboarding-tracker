<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Gathering_Info_Notes</fullName>
    <active>true</active>
    <description
  >Requires Gathering Info Notes before an onboarding moves to any stage after Gathering Info.</description>
    <errorConditionFormula
  >NOT($Setup.Automation_Bypass__c.Bypass_Validation_Rules__c) &amp;&amp;
ISCHANGED(Stage__c) &amp;&amp;
CASE(TEXT(Stage__c),
    "Kickoff_Scheduled", 1,
    "Gathering_Info", 2,
    "Implementation", 3,
    "QA_Review", 4,
    "Go_Live", 5,
    "Post_Launch_Review", 6,
    0
) &gt; 2 &amp;&amp;
ISBLANK(Gathering_Info_Notes__c)</errorConditionFormula>
    <errorDisplayField>Gathering_Info_Notes__c</errorDisplayField>
    <errorMessage
  >Add Gathering Info Notes before moving past Gathering Info.</errorMessage>
</ValidationRule>
